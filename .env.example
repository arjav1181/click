# Click environment. Copy to .env and fill in. Never commit .env.
# Everything here is optional for a local demo except DATABASE_URL.

# --- app -------------------------------------------------------------------
# Public URL. Use https:// for anything reachable outside your machine; cookies
# are marked Secure only when this starts with https://.
APP_URL=http://localhost:3000
NODE_ENV=development
CLICK_VERSION=dev

# --- database --------------------------------------------------------------
# Self-hosted with Docker Compose builds this for you; local dev example:
DATABASE_URL=postgres://click:click@127.0.0.1:5432/click
DATABASE_POOL_MAX=10

# Used by infra/compose/docker-compose.yml only.
POSTGRES_USER=click
POSTGRES_PASSWORD=change-me
POSTGRES_DB=click

# --- secrets ---------------------------------------------------------------
# Generate each with: openssl rand -base64 32
APP_SECRET=
# Encrypts calendar refresh tokens. 32-byte base64 or hex. Changing it makes
# existing stored tokens unreadable (users reconnect calendars).
ENCRYPTION_KEY=
# HMAC secret the bot runner uses for /internal/v1 callbacks.
BOT_WEBHOOK_SECRET=

# --- sessions --------------------------------------------------------------
SESSION_COOKIE_NAME=click_session

# --- jobs ------------------------------------------------------------------
# Leave empty to run jobs inside the web process (single-node demos).
# Set to use the worker and BullMQ. Docker Compose sets this to redis://redis:6379.
REDIS_URL=
WORKER_CONCURRENCY=2
WORKER_HEALTH_PORT=8081

# --- storage ---------------------------------------------------------------
# local writes under STORAGE_DIR; s3 works with MinIO, R2, Backblaze, AWS.
STORAGE_DRIVER=local
STORAGE_DIR=.data/uploads
MAX_UPLOAD_MB=500
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=click
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- email -----------------------------------------------------------------
# Without SMTP, development writes messages to .data/mail and returns a dev
# link from the magic-link endpoint. Production requires SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Click <click@example.com>

# --- ASR (speech to text) --------------------------------------------------
# mock   no key, deterministic demo transcript (default)
# local  apps/asr faster-whisper, set ASR_URL
# openai OpenAI-compatible /audio/transcriptions endpoint
ASR_PROVIDER=mock
ASR_URL=http://127.0.0.1:8000
ASR_API_KEY=
ASR_MODEL=whisper-1
ASR_LANGUAGE=
ASR_BASE_URL=https://api.openai.com/v1
# Docker ASR service
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8

# --- LLM -------------------------------------------------------------------
# mock   deterministic extractive notes, no key (default)
# openai any OpenAI-compatible chat completions endpoint (OpenAI, Groq,
#        Together, OpenRouter, Ollama, vLLM, LM Studio)
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=3000

# --- semantic search (optional, needs pgvector) ----------------------------
EMBEDDINGS_ENABLED=false
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- spend metering --------------------------------------------------------
# 0 disables the cap. Costs are estimates only; see replica/backend.md.
BUDGET_CAP_USD=50
ASR_COST_PER_MINUTE=0.006
LLM_INPUT_COST_PER_1K=0.00015
LLM_OUTPUT_COST_PER_1K=0.0006

# --- single sign-on (OIDC) -------------------------------------------------
# Works with any OIDC provider; redirect URI is
# $APP_URL/api/v1/auth/oidc/callback unless overridden.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISPLAY_NAME=Single sign-on
OIDC_SCOPES=openid email profile
OIDC_REDIRECT_URI=

# --- demo seed -------------------------------------------------------------
SEED_PASSWORD=click-demo-2026

# --- compose ---------------------------------------------------------------
MINIO_ROOT_USER=click
MINIO_ROOT_PASSWORD=click-minio-password
